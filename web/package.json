{
  "name": "hreasy-web",
  "version": "1.4.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=26 <27",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check:win-text-integrity": "powershell -ExecutionPolicy Bypass -File tools/check-text-integrity-windows.ps1 -SkipUnicodeEscapes -SkipBom",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@mdi/font": "^7.4.47",
    "@revolist/vue3-datagrid": "^4.26.2",
    "axios": "1.20.0",
    "dompurify": "3.4.14",
    "markdown-it": "15.0.1",
    "markdown-it-emoji": "^3.1.0",
    "pinia": "4.0.3",
    "svg-pan-zoom": "^3.6.2",
    "vis-timeline": "8.5.4",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10",
    "vue-router": "5.3.0",
    "vuetify": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tsconfig/node26": "26.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/node": "26.4.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.9.1",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-vue": "10.10.0",
    "happy-dom": "20.12.0",
    "jiti": "2.7.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "resize-observer-polyfill": "^1.5.1",
    "sass-embedded": "1.103.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-vue-devtools": "8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "js-beautify": {
      "editorconfig": "3.0.2",
      "glob": "11.1.0"
    }
  }
}
