{
  "name": "hreasy-web",
  "version": "1.4.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=26 <27",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check:win-text-integrity": "powershell -ExecutionPolicy Bypass -File tools/check-text-integrity-windows.ps1 -SkipUnicodeEscapes -SkipBom",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@mdi/font": "^7.4.47",
    "@revolist/vue3-datagrid": "^4.28.0",
    "axios": "1.20.0",
    "dompurify": "3.4.16",
    "fuse.js": "^7.5.0",
    "markdown-it": "15.0.2",
    "markdown-it-emoji": "^3.1.0",
    "pinia": "4.0.3",
    "svg-pan-zoom": "^3.6.2",
    "vis-timeline": "8.5.4",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "vue-router": "5.3.1",
    "vuetify": "4.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tsconfig/node26": "26.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/node": "26.6.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.11.0",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "20.14.5",
    "jiti": "2.7.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.9",
    "resize-observer-polyfill": "^1.5.1",
    "sass-embedded": "1.105.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-vue-devtools": "8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
